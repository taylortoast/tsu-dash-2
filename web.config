<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- <add name="TSUDashboardDb" connectionString="Data Source=localhost;Initial Catalog=TSU-Dashboard;Integrated Security=True;TrustServerCertificate=True" providerName="System.Data.SqlClient" /> -->
    <add name="TSUDataConnString" connectionString="Server=localhost; Database=TSDB; Integrated Security=True" providerName="System.Data.SqlClient" />
    <add name="RumpDb" connectionString="Data Source=MAHG-DB-3202v;Initial Catalog=RUMP;Integrated Security=True;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
    <add name="TSUDashboardDb"
       connectionString="Server=.\SQLEXPRESS;Database=TSU-Dashboard;Integrated Security=True;TrustServerCertificate=True;"
       providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Configure a SELECT that returns Title, Description, and optional PointOfContact, LatestUpdate, EstimatedCompletionDate columns. -->
    <add key="RumpPullQuery" value="" />
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true" />
  </appSettings>
  <system.web>
    <httpRuntime targetFramework="4.5" />
    <httpCookies requireSSL="true" />
    <sessionState timeout="15" />

    <identity impersonate="false" />
    <customErrors mode="Off" />
    <authorization>
      <allow users="*" />
    </authorization>
  </system.web>
   <!-- =================================================================== -->
  <!-- START: ADDED SECTION FOR PUBLIC DASHBOARD ANONYMOUS ACCESS          -->
  <!-- This section creates security exceptions for your public files.     -->
  <!-- =================================================================== -->

  <location path="public-board-v2.html">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="js/public-board-v2.js">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="css/public-board-v2.css">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <!-- Corrected path for the WebSocket handler -->
  <location path="api/public-board/socket.ashx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <!-- Corrected path for the active posts data handler -->
  <location path="api/public-board/active-posts.ashx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>


  <!-- =================================================================== -->
  <!-- END: ADDED SECTION                                                  -->
  <!-- =================================================================== -->

  <system.webServer>
    <security>
      <requestFiltering allowDoubleEscaping="true" allowHighBitCharacters="true">
        <requestLimits maxAllowedContentLength="2147483648" />
        <fileExtensions allowUnlisted="true" />
      </requestFiltering>
            <authorization>
                <add accessType="Allow" users="?" />
            </authorization>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>

    <httpErrors errorMode="Detailed" />    
    <defaultDocument>
        <files>
            <clear />
            <add value="index.html" />
        </files>
    </defaultDocument>
  </system.webServer>
  
</configuration>
