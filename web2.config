<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Change Data Source if the dashboard database is not hosted on the IIS server. -->
    <add name="TSUDashboardDb"
         connectionString="Data Source=MAHG-DB-3202v;Initial Catalog=TSU-Dashboard;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
    <add name="TSUDataConnString"
         connectionString="Server=MAHG-DB-3202v;Database=TSDB;Integrated Security=True"
         providerName="System.Data.SqlClient" />
    <add name="RumpDb"
         connectionString="Data Source=MAHG-DB-3202v;Initial Catalog=RUMP;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Configure before using the RUMP pull feature. -->
    <add key="RumpPullQuery" value="" />
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true" />
  </appSettings>

  <system.web>
    <httpRuntime targetFramework="4.5" />
    <httpCookies requireSSL="true" />
    <sessionState timeout="15" />

    <!-- Keep SQL access on the IIS application pool identity. -->
    <identity impersonate="false" />

    <!-- Use RemoteOnly for production; temporarily set Off only while diagnosing deployment errors. -->
    <customErrors mode="RemoteOnly" />

    <!-- The authenticated dashboard requires IIS Windows/CAC authentication. -->
    <authorization>
      <deny users="?" />
    </authorization>
  </system.web>

  <!-- Public board exceptions. These only allow anonymous access if IIS also enables Anonymous Authentication for these paths. -->
  <location path="public-board-v2.html">
    <system.web>
      <authorization>
        <allow users="?" />
      </authorization>
    </system.web>
  </location>

  <location path="js/public-board-v2.js">
    <system.web>
      <authorization>
        <allow users="?" />
      </authorization>
    </system.web>
  </location>

  <location path="css/public-board-v2.css">
    <system.web>
      <authorization>
        <allow users="?" />
      </authorization>
    </system.web>
  </location>

  <location path="api/public-board/socket.ashx">
    <system.web>
      <authorization>
        <allow users="?" />
      </authorization>
    </system.web>
  </location>

  <location path="api/public-board/active-posts.ashx">
    <system.web>
      <authorization>
        <allow users="?" />
      </authorization>
    </system.web>
  </location>

  <system.webServer>
    <security>
      <requestFiltering allowDoubleEscaping="true" allowHighBitCharacters="true">
        <requestLimits maxAllowedContentLength="2147483648" />
        <fileExtensions allowUnlisted="true" />
      </requestFiltering>
      <authorization>
        <add accessType="Allow" users="*" />
      </authorization>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>

    <httpErrors errorMode="Custom" />

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
